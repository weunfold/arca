# One image line: Ubuntu 26.04, GitHub's ubuntu-26.04 label (and ubuntu-latest from November 2026, runner-images
# issue 14748). check-release.sh moves the four pins below to GitHub's newest release of this line; build.sh reads
# the file. Shell syntax, values only, no commands.
IMAGE_OS=ubuntu26
RUNNER_IMAGES_TAG=ubuntu26/20261111.196
RUNNER_IMAGES_COMMIT=93a4e4e98715026b60fdf86893cf193b4be3bd47
# GitHub's ImageVersion for that tag, from the release notes ("Image Version: ...").
IMAGE_VERSION=20261111.196.1
# Fixed per line.
TEMPLATE=build.ubuntu-26_04.pkr.hcl
README=Ubuntu2604-Readme.md
GITHUB_REPORT=internal.ubuntu26.json
BASE_IMAGE=images:ubuntu/26.04/cloud
