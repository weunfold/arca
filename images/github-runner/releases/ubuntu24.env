# One image line: Ubuntu 24.04, GitHub's ubuntu-24.04 label. check-release.sh moves the four pins below to GitHub's
# newest release of this line; build.sh reads the file. Shell syntax, values only, no commands.
IMAGE_OS=ubuntu24
RUNNER_IMAGES_TAG=ubuntu24/20261111.370
RUNNER_IMAGES_COMMIT=fb099341ddaf44a428fb17495341cb7c2300faf2
# GitHub's ImageVersion for that tag, from the release notes ("Image Version: ...").
IMAGE_VERSION=20261111.370.1
# Fixed per line.
TEMPLATE=build.ubuntu-24_04.pkr.hcl
README=Ubuntu2404-Readme.md
GITHUB_REPORT=internal.ubuntu24.json
BASE_IMAGE=images:ubuntu/24.04/cloud
