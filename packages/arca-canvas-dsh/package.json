{
  "name": "arca-canvas-dsh",
  "version": "0.29.0",
  "description": "Automagik Arca snapshots and a Doctor chat with in-canvas approvals for DSH",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/automagik-si/arca.git",
    "directory": "packages/arca-canvas-dsh"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/arca-client.js",
    "src/token.js",
    "src/devices-client.js",
    "src/snapshot.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "src/approval.js",
    "page.js",
    "page.css",
    "src/chat.js",
    "src/model.js",
    "src/fleet.js",
    "src/render.js",
    "src/page.js",
    "src/client.js",
    "src/canvas.css",
    "src/open-intelligence.js"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "playwright": "1.64.0"
  }
}
